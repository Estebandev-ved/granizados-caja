# Solo hace falta si el frontend se despliega separado del backend (ej: frontend en Vercel, backend en Railway).
# Vacío o sin esta variable, la app llama a /api en el mismo dominio (como cuando Spring Boot sirve todo junto).
# Se pone en las variables de entorno de Vercel (Project Settings → Environment Variables), no aquí.
VITE_API_URL=https://tu-backend.up.railway.app
