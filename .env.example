# Variables del servicio en Railway (Settings → Variables). Nada de esto va en git.

# PIN para entrar a la app (solo números, 4 a 8 dígitos)
APP_PIN=
# Llave para firmar la sesión: mínimo 32 caracteres al azar. Genera una con:  openssl rand -base64 48
JWT_SECRET=

# Base de datos: en Railway se enlazan desde el servicio Postgres (ver README)
PGHOST=${{Postgres.PGHOST}}
PGPORT=${{Postgres.PGPORT}}
PGDATABASE=${{Postgres.PGDATABASE}}
PGUSER=${{Postgres.PGUSER}}
PGPASSWORD=${{Postgres.PGPASSWORD}}

# Opcional: avisos por Telegram (stock bajo, cierre diario 9pm, pedido domingo 7pm)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Solo si en tu PC usas un PostgreSQL local en vez del H2 por defecto
# (perfil "local", application-local.yml). Expórtalas en tu shell antes
# de correr el backend, por ejemplo: export DB_LOCAL_PASSWORD=...
DB_LOCAL_USER=postgres
DB_LOCAL_PASSWORD=
