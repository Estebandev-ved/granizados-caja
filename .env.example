# Variables del servicio en Railway (Settings → Variables). Nada de esto va en git.

# PIN para entrar a la app (solo números, 4 a 8 dígitos)
APP_PIN=
# Llave para firmar la sesión: mínimo 32 caracteres al azar. Genera una con:  openssl rand -base64 48
JWT_SECRET=

# Base de datos: en Railway se enlazan desde el servicio Postgres (ver README)
PGHOST=${{Postgres.PGHOST}}
PGPORT=${{Postgres.PGPORT}}
PGDATABASE=${{Postgres.PGDATABASE}}
PGUSER=${{Postgres.PGUSER}}
PGPASSWORD=${{Postgres.PGPASSWORD}}

# Negocio por defecto: el de quien entra con PIN o Face ID y el dueño de las tareas programadas y del Telegram.
# 1 = Dopamina Cocktails. Cámbialo solo cuando se conozca el id de Dopamina en Antigravity.
NEGOCIO_ID=1
# Opcional: entrar con la cuenta de Antigravity. Mismo valor que CAJA_JWT_SECRET en Antigravity (mínimo 32 caracteres,
# distinto de JWT_SECRET). Vacío = apagado, solo PIN y Face ID.
CAJA_JWT_SECRET=

# Opcional: avisos por Telegram (stock bajo, cierre diario 9pm, pedido domingo 7pm)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional: solo si el frontend vive en otro dominio que el backend (ej: frontend en Vercel, backend en Railway).
# WEBAUTHN_RP_ID: el dominio EXACTO desde el que se abre la app en el celular, o un dominio padre de ese
# (nunca un subdominio distinto: si abres desde "midominio.com", el rpId no puede ser "www.midominio.com").
# WEBAUTHN_ORIGENES: los orígenes completos con https://, separados por coma (se usa para CORS y para Face ID).
# Sin esto, por defecto se usa el dominio que Railway pone solo (RAILWAY_PUBLIC_DOMAIN).
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGENES=
